PORT=3001
CLIENT_ORIGIN=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cresa_library
DB_USER=cresa_app
DB_PASSWORD=change_this_password
DB_CONNECTION_LIMIT=10
# Optional: an account permitted to create the database the first time the API starts.
# Leave blank when DB_USER already has CREATE DATABASE permission.
DB_BOOTSTRAP_USER=
DB_BOOTSTRAP_PASSWORD=
# Gemini is called only by the API server. Never expose this value as a VITE_* variable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
