# ─────────────────────────────────────────────
# Cresa Library – environment variables
# Copy this file to .env and fill in the values.
# Never commit .env to source control.
# ─────────────────────────────────────────────

# ── PostgreSQL (local dev) ───────────────────
# On Render, DATABASE_URL is injected automatically.
# For local dev, either set DATABASE_URL or the individual vars below.

# Full connection string (takes precedence when set)
# DATABASE_URL=postgresql://cresa_app:yourpassword@127.0.0.1:5432/cresa_library

# Individual connection params (used when DATABASE_URL is not set)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=cresa_app
DB_PASSWORD=yourpassword
DB_NAME=cresa_library
DB_CONNECTION_LIMIT=10

# ── Server ───────────────────────────────────
PORT=3001
NODE_ENV=development

# Allowed CORS origin for the React dev server
CLIENT_ORIGIN=http://localhost:5173

# ── Gemini AI ────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash-latest

# ── Book storage ─────────────────────────────
# Absolute path to the folder that holds PDF/DOCX files.
# Defaults to <project-root>/public/books when not set.
# BOOKS_DIR=/absolute/path/to/books
